{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccc-native-canary-result-v1",
  "title": "CCC native canary result",
  "description": "Redacted result fields for one manual synthetic canary execution. Final values must be filled by the parent after one functional run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "fixture_sha256",
    "route",
    "expected_child_count",
    "observed_child_count",
    "children_distinct",
    "worktree_unchanged",
    "requested_model",
    "resolved_model",
    "requested_effort",
    "resolved_effort",
    "fallback",
    "failure_class",
    "verification",
    "task_result",
    "wall_time_ms",
    "parent_rework"
  ],
  "properties": {
    "schema_version": {
      "const": "ccc-native-canary-result-v1"
    },
    "scenario_id": {
      "enum": [
        "solo-guard",
        "parallel-read",
        "fast-route-fallback",
        "bounded-implementation",
        "standard-judgment",
        "frontier-seeded-defect-review"
      ]
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "route": {
      "enum": [
        "solo",
        "parallel-read",
        "fast",
        "bounded",
        "standard",
        "frontier"
      ]
    },
    "expected_child_count": {
      "type": "integer",
      "minimum": 0
    },
    "observed_child_count": {
      "type": "integer",
      "minimum": 0
    },
    "children_distinct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "worktree_unchanged": {
      "description": "True when the post-scenario worktree state exactly matches its pre-scenario baseline; the baseline need not be clean.",
      "type": "boolean"
    },
    "requested_model": {
      "description": "The explicit model request, never a claim about runtime resolution.",
      "enum": [
        null,
        "gpt-5.3-codex-spark",
        "gpt-5.6-luna",
        "gpt-5.6-terra",
        "gpt-5.6-sol"
      ]
    },
    "resolved_model": {
      "description": "The observed runtime model when the host exposes it; null when unavailable.",
      "enum": [
        null,
        "gpt-5.3-codex-spark",
        "gpt-5.6-luna",
        "gpt-5.6-terra",
        "gpt-5.6-sol"
      ]
    },
    "requested_effort": {
      "enum": [
        null,
        "low",
        "high",
        "xhigh",
        "max"
      ]
    },
    "resolved_effort": {
      "enum": [
        null,
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ]
    },
    "fallback": {
      "enum": [
        "none",
        "spark_to_luna"
      ]
    },
    "failure_class": {
      "enum": [
        "none",
        "model_unavailable",
        "quota_denied",
        "capacity",
        "timeout",
        "child_error",
        "evidence_missing",
        "unknown"
      ]
    },
    "verification": {
      "description": "Routing-evidence outcome only; this is not a task-result verdict.",
      "enum": [
        "VERIFIED",
        "NOT_VERIFIED"
      ]
    },
    "task_result": {
      "description": "Whether the parent judged the synthetic functional task PASS or FAIL.",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "wall_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "parent_rework": {
      "description": "Coarse parent rework observed after the child result.",
      "enum": [
        "none",
        "minor",
        "substantial",
        "unknown"
      ]
    }
  }
}
